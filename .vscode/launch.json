{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Music Playlist Manager",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}\\build\\playlist-manager.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\msys64\\mingw64\\bin\\gdb.exe",
            "preLaunchTask": "build",
            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
